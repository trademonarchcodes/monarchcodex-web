            </h1>

            <p>
                Your MONARCH CODEX command center.
            </p>
        </section>

        <div
            id="messageBox"
            class="message-box"
        ></div>

        <section class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">
                    TOTAL INVESTED
                </div>

                <div
                    class="stat-value"
                    id="totalInvested"
                >
                    $0.00
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    CONFIRMED
                </div>

                <div
                    class="stat-value"
                    id="confirmedInvestments"
                >
                    0
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    PENDING
                </div>

                <div
                    class="stat-value"
                    id="pendingInvestments"
                >
                    0
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    REQUESTS
                </div>

                <div
                    class="stat-value"
                    id="totalRequests"
                >
                    0
                </div>
            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Profile</h2>
                <span>MONARCH ACCOUNT</span>
            </div>

            <div class="profile-grid">

                <div class="info-card">
                    <div class="info-label">FULL NAME</div>
                    <div class="info-value" id="profileFullName">
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">PHONE</div>
                    <div class="info-value" id="profilePhone">
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">ACCOUNT STATUS</div>
                    <div class="info-value" id="profileStatus">
                        —
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Account Overview</h2>
                <span>YOUR CODEX PROFILE</span>
            </div>

            <div class="overview-grid">

                <div class="info-card">
                    <div class="info-label">MEMBER TYPE</div>
                    <div class="info-value">
                        MONARCH
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">ROLE</div>
                    <div
                        class="info-value"
                        id="profileRole"
                    >
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">MEMBER SINCE</div>
                    <div
                        class="info-value"
                        id="profileCreatedAt"
                    >
                        —
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Investment Packages</h2>
                <span>SELECT A PACKAGE</span>
            </div>

            <div
                id="packagesContent"
                class="packages-grid"
            >
                <div class="loading-card">
                    Loading packages...
                </div>
            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Payment Method</h2>
                <span>SELECT METHOD</span>
            </div>

            <div class="payment-grid">

                <button
                    type="button"
                    class="payment-option"
                    data-payment="bank"
                >
                    <strong>Bank Transfer</strong>
                    <small>
                        Pay through the available bank details.
                    </small>
                </button>

                <button
                    type="button"
                    class="payment-option"
                    data-payment="crypto"
                >
                    <strong>Cryptocurrency</strong>
                    <small>
                        Pay using the available crypto option.
                    </small>
                </button>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Submit Investment Request</h2>
                <span>REQUEST REVIEW</span>
            </div>

            <div class="action-card">

                <p>
                    Select a package and payment method above,
                    then submit your request for review.
                </p>

                <button
                    type="button"
                    class="primary-btn"
                    id="submitInvestmentBtn"
                >
                    Submit Investment Request
                </button>

            </div>

        </section>
        <section class="dashboard-section">

            <div class="section-title">
                <h2>Earnings</h2>
                <span>YOUR EARNINGS RECORD</span>
            </div>

            <div class="earnings-summary">

                <div class="earning-total-card">
                    <div class="stat-label">
                        TOTAL EARNINGS
                    </div>

                    <div
                        class="earning-total"
                        id="totalEarnings"
                    >
                        $0.00
                    </div>

                    <p>
                        Confirmed earnings recorded on your account.
                    </p>
                </div>

            </div>

            <div class="earnings-history-card">

                <div class="history-header">
                    <h3>Earnings History</h3>
                </div>

                <div
                    id="earningsContent"
                    class="table-wrapper"
                >
                    <div class="loading-card">
                        Loading earnings...
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Investment History</h2>
                <span>YOUR REQUESTS</span>
            </div>

            <div
                id="historyContent"
                class="history-card"
            >
                <div class="loading-card">
                    Loading investment history...
                </div>
            </div>

        </section>

    </main>

    <footer class="dashboard-footer">
        <div class="dashboard-container footer-inner">
            <strong>MONARCH CODEX</strong>

            <span>
                Making The Kingdom Of GOD A Reality On The Earth.
            </span>
        </div>
    </footer>

</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
    const SUPABASE_URL =
        "https://avaworleivncevaoqeny.supabase.co";

    const SUPABASE_PUBLISHABLE_KEY =
        "sb_publishable_OZCDmpzZ1-pvN1rfTGqrpw_JatYPjIh";

    const supabaseClient =
        window.supabase.createClient(
            SUPABASE_URL,
            SUPABASE_PUBLISHABLE_KEY
        );

    let currentUser = null;
    let currentProfile = null;

    let packagesData = [];
    let investmentsData = [];
    let earningsData = [];

    let selectedPackage = null;
    let selectedPaymentMethod = null;

    const memberName =
        document.getElementById("memberName");

    const messageBox =
        document.getElementById("messageBox");

    const profileFullName =
        document.getElementById("profileFullName");

    const profilePhone =
        document.getElementById("profilePhone");

    const profileStatus =
        document.getElementById("profileStatus");

    const profileRole =
        document.getElementById("profileRole");

    const profileCreatedAt =
        document.getElementById("profileCreatedAt");

    const packagesContent =
        document.getElementById("packagesContent");

    const historyContent =
        document.getElementById("historyContent");

    const earningsContent =
        document.getElementById("earningsContent");

    const totalInvested =
        document.getElementById("totalInvested");

    const confirmedInvestments =
        document.getElementById("confirmedInvestments");

    const pendingInvestments =
        document.getElementById("pendingInvestments");

    const totalRequests =
        document.getElementById("totalRequests");

    const totalEarnings =
        document.getElementById("totalEarnings");

    const submitInvestmentBtn =
        document.getElementById("submitInvestmentBtn");

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
    function showMessage(message, type = "success") {
        messageBox.textContent = message;
        messageBox.className =
            "message-box " + type;

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }

    function clearMessage() {
        messageBox.textContent = "";
        messageBox.className = "message-box";
    }

    function formatAmount(amount) {
        const number = Number(amount) || 0;

        return new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD",
            minimumFractionDigits: 2
        }).format(number);
    }

    function formatDate(dateValue) {
        if (!dateValue) {
            return "—";
        }

        const date = new Date(dateValue);

        if (Number.isNaN(date.getTime())) {
            return "—";
        }

        return date.toLocaleDateString(
            "en-US",
            {
                year: "numeric",
                month: "short",
                day: "numeric"
            }
        );
    }

    function getStatusClass(status) {
        const value =
            String(status || "pending").toLowerCase();

        if (value === "confirmed" ||
            value === "active") {
            return "status-confirmed";
        }

        if (value === "rejected" ||
            value === "blocked") {
            return "status-rejected";
        }

        return "status-pending";
    }

    async function checkMemberAuthorization() {

        clearMessage();

        const {
            data: authData,
            error: authError
        } = await supabaseClient.auth.getUser();

        if (authError || !authData.user) {
            window.location.href = "login.html";
            return false;
        }

        currentUser = authData.user;

        const {
            data: profile,
            error: profileError
        } = await supabaseClient
            .from("profiles")
            .select("*")
            .eq("id", currentUser.id)
            .single();

        if (profileError || !profile) {
            showMessage(
                "Unable to load your member profile.",
                "error"
            );
            return false;
        }

        if (
            profile.role === "admin" &&
            profile.status === "active"
        ) {
            window.location.href = "admin.html";
            return false;
        }

        if (profile.status === "blocked") {

            await supabaseClient.auth.signOut();

            window.location.href = "login.html";

            return false;
        }

        currentProfile = profile;

        return true;
    }

    function displayProfile() {

        if (!currentProfile) {
            return;
        }

        const name =
            currentProfile.full_name || "Monarch";

        memberName.textContent = name;

        profileFullName.textContent =
            currentProfile.full_name || "—";

        profilePhone.textContent =
            currentProfile.phone || "—";

        profileStatus.textContent =
            currentProfile.status || "—";

        profileRole.textContent =
            currentProfile.role || "member";

        profileCreatedAt.textContent =
            formatDate(currentProfile.created_at);
    }

    function getPackageName(pkg) {

        if (!pkg) {
            return "Investment Package";
        }

        return (
            pkg.name ||
            pkg.title ||
            pkg.package_name ||
            "Investment Package"
        );
    }

    function getPackageAmount(pkg) {

        if (!pkg) {
            return 0;
        }

        return Number(
            pkg.amount ??
            pkg.price ??
            pkg.package_amount ??
            0
        );
    }