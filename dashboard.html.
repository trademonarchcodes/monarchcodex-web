<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MONARCH CODEX | Member Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Poppins", sans-serif;
            background: #050505;
            color: #ffffff;
        }

        .dashboard-page {
            min-height: 100vh;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(212, 175, 55, 0.10),
                    transparent 35%
                ),
                #050505;
        }

        .dashboard-header {
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(212, 175, 55, 0.20);
            background: rgba(5, 5, 5, 0.96);
            backdrop-filter: blur(12px);
        }

        .header-inner {
            width: min(1200px, 92%);
            margin: auto;
            min-height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .brand {
            color: #D4AF37;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .monarch-badge {
            border: 1px solid #D4AF37;
            color: #D4AF37;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .logout-btn {
            border: 1px solid rgba(212, 175, 55, 0.6);
            background: transparent;
            color: #ffffff;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
        }

        .logout-btn:hover {
            background: #D4AF37;
            color: #000000;
        }

        .dashboard-container {
            width: min(1200px, 92%);
            margin: 0 auto;
            padding: 35px 0 60px;
        }

        .welcome-section {
            margin-bottom: 25px;
        }

        .welcome-section h1 {
            margin: 0 0 8px;
            font-size: clamp(25px, 5vw, 38px);
        }

        .welcome-section h1 span {
            color: #D4AF37;
        }

        .welcome-section p {
            margin: 0;
            color: #aaaaaa;
            font-size: 14px;
        }

        .message-box {
            display: none;
            margin-bottom: 20px;
            padding: 13px 16px;
            border-radius: 8px;
            font-size: 13px;
        }

        .message-box.success {
            display: block;
            border: 1px solid rgba(70, 180, 100, 0.5);
            background: rgba(70, 180, 100, 0.10);
            color: #9be7ad;
        }

        .message-box.error {
            display: block;
            border: 1px solid rgba(220, 70, 70, 0.5);
            background: rgba(220, 70, 70, 0.10);
            color: #ffaaaa;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat-card {
            padding: 20px;
            border: 1px solid rgba(212, 175, 55, 0.18);
            border-radius: 10px;
            background: #0d0d0d;
        }

        .stat-label {
            color: #999999;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .stat-value {
            color: #D4AF37;
            font-size: 25px;
            font-weight: 800;
        }
    </style>
</head>

<body>

<div class="dashboard-page">

    <header class="dashboard-header">
        <div class="header-inner">

            <div class="brand">
                MONARCH CODEX
            </div>

            <div class="header-right">
                <span class="monarch-badge">
                    MONARCH
                </span>

                <button
                    type="button"
                    class="logout-btn"
                    id="logoutBtn"
                >
                    Logout
                </button>
            </div>

        </div>
    </header>

    <main class="dashboard-container">

        <section class="welcome-section">
            <h1>
                Welcome,
                <span id="memberName">Monarch</span>
            </h1>

            <p>
                Your MONARCH CODEX command center.
            </p>
        </section>

        <div
            id="messageBox"
            class="message-box"
        ></div>

        <section class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">
                    TOTAL INVESTED
                </div>

                <div
                    class="stat-value"
                    id="totalInvested"
                >
                    $0.00
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    CONFIRMED
                </div>

                <div
                    class="stat-value"
                    id="confirmedInvestments"
                >
                    0
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    PENDING
                </div>

                <div
                    class="stat-value"
                    id="pendingInvestments"
                >
                    0
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    REQUESTS
                </div>

                <div
                    class="stat-value"
                    id="totalRequests"
                >
                    0
                </div>
            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Profile</h2>
                <span>MONARCH ACCOUNT</span>
            </div>

            <div class="profile-grid">

                <div class="info-card">
                    <div class="info-label">FULL NAME</div>
                    <div class="info-value" id="profileFullName">
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">PHONE</div>
                    <div class="info-value" id="profilePhone">
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">ACCOUNT STATUS</div>
                    <div class="info-value" id="profileStatus">
                        —
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Account Overview</h2>
                <span>YOUR CODEX PROFILE</span>
            </div>

            <div class="overview-grid">

                <div class="info-card">
                    <div class="info-label">MEMBER TYPE</div>
                    <div class="info-value">
                        MONARCH
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">ROLE</div>
                    <div
                        class="info-value"
                        id="profileRole"
                    >
                        —
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">MEMBER SINCE</div>
                    <div
                        class="info-value"
                        id="profileCreatedAt"
                    >
                        —
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Investment Packages</h2>
                <span>SELECT A PACKAGE</span>
            </div>

            <div
                id="packagesContent"
                class="packages-grid"
            >
                <div class="loading-card">
                    Loading packages...
                </div>
            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Payment Method</h2>
                <span>SELECT METHOD</span>
            </div>

            <div class="payment-grid">

                <button
                    type="button"
                    class="payment-option"
                    data-payment="bank"
                >
                    <strong>Bank Transfer</strong>
                    <small>
                        Pay through the available bank details.
                    </small>
                </button>

                <button
                    type="button"
                    class="payment-option"
                    data-payment="crypto"
                >
                    <strong>Cryptocurrency</strong>
                    <small>
                        Pay using the available crypto option.
                    </small>
                </button>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Submit Investment Request</h2>
                <span>REQUEST REVIEW</span>
            </div>

            <div class="action-card">

                <p>
                    Select a package and payment method above,
                    then submit your request for review.
                </p>

                <button
                    type="button"
                    class="primary-btn"
                    id="submitInvestmentBtn"
                >
                    Submit Investment Request
                </button>

            </div>

        </section>
        <section class="dashboard-section">

            <div class="section-title">
                <h2>Earnings</h2>
                <span>YOUR EARNINGS RECORD</span>
            </div>

            <div class="earnings-summary">

                <div class="earning-total-card">
                    <div class="stat-label">
                        TOTAL EARNINGS
                    </div>

                    <div
                        class="earning-total"
                        id="totalEarnings"
                    >
                        $0.00
                    </div>

                    <p>
                        Confirmed earnings recorded on your account.
                    </p>
                </div>

            </div>

            <div class="earnings-history-card">

                <div class="history-header">
                    <h3>Earnings History</h3>
                </div>

                <div
                    id="earningsContent"
                    class="table-wrapper"
                >
                    <div class="loading-card">
                        Loading earnings...
                    </div>
                </div>

            </div>

        </section>

        <section class="dashboard-section">

            <div class="section-title">
                <h2>Investment History</h2>
                <span>YOUR REQUESTS</span>
            </div>

            <div
                id="historyContent"
                class="history-card"
            >
                <div class="loading-card">
                    Loading investment history...
                </div>
            </div>

        </section>

    </main>

    <footer class="dashboard-footer">
        <div class="dashboard-container footer-inner">
            <strong>MONARCH CODEX</strong>

            <span>
                Making The Kingdom Of GOD A Reality On The Earth.
            </span>
        </div>
    </footer>

</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
    const SUPABASE_URL =
        "https://avaworleivncevaoqeny.supabase.co";

    const SUPABASE_PUBLISHABLE_KEY =
        "sb_publishable_OZCDmpzZ1-pvN1rfTGqrpw_JatYPjIh";

    const supabaseClient =
        window.supabase.createClient(
            SUPABASE_URL,
            SUPABASE_PUBLISHABLE_KEY
        );

    let currentUser = null;
    let currentProfile = null;

    let packagesData = [];
    let investmentsData = [];
    let earningsData = [];

    let selectedPackage = null;
    let selectedPaymentMethod = null;

    const memberName =
        document.getElementById("memberName");

    const messageBox =
        document.getElementById("messageBox");

    const profileFullName =
        document.getElementById("profileFullName");

    const profilePhone =
        document.getElementById("profilePhone");

    const profileStatus =
        document.getElementById("profileStatus");

    const profileRole =
        document.getElementById("profileRole");

    const profileCreatedAt =
        document.getElementById("profileCreatedAt");

    const packagesContent =
        document.getElementById("packagesContent");

    const historyContent =
        document.getElementById("historyContent");

    const earningsContent =
        document.getElementById("earningsContent");

    const totalInvested =
        document.getElementById("totalInvested");

    const confirmedInvestments =
        document.getElementById("confirmedInvestments");

    const pendingInvestments =
        document.getElementById("pendingInvestments");

    const totalRequests =
        document.getElementById("totalRequests");

    const totalEarnings =
        document.getElementById("totalEarnings");

    const submitInvestmentBtn =
        document.getElementById("submitInvestmentBtn");

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
    function showMessage(message, type = "success") {
        messageBox.textContent = message;
        messageBox.className =
            "message-box " + type;

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }

    function clearMessage() {
        messageBox.textContent = "";
        messageBox.className = "message-box";
    }

    function formatAmount(amount) {
        const number = Number(amount) || 0;

        return new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD",
            minimumFractionDigits: 2
        }).format(number);
    }

    function formatDate(dateValue) {
        if (!dateValue) {
            return "—";
        }

        const date = new Date(dateValue);

        if (Number.isNaN(date.getTime())) {
            return "—";
        }

        return date.toLocaleDateString(
            "en-US",
            {
                year: "numeric",
                month: "short",
                day: "numeric"
            }
        );
    }

    function getStatusClass(status) {
        const value =
            String(status || "pending").toLowerCase();

        if (value === "confirmed" ||
            value === "active") {
            return "status-confirmed";
        }

        if (value === "rejected" ||
            value === "blocked") {
            return "status-rejected";
        }

        return "status-pending";
    }

    async function checkMemberAuthorization() {

        clearMessage();

        const {
            data: authData,
            error: authError
        } = await supabaseClient.auth.getUser();

        if (authError || !authData.user) {
            window.location.href = "login.html";
            return false;
        }

        currentUser = authData.user;

        const {
            data: profile,
            error: profileError
        } = await supabaseClient
            .from("profiles")
            .select("*")
            .eq("id", currentUser.id)
            .single();

        if (profileError || !profile) {
            showMessage(
                "Unable to load your member profile.",
                "error"
            );
            return false;
        }

        if (
            profile.role === "admin" &&
            profile.status === "active"
        ) {
            window.location.href = "admin.html";
            return false;
        }

        if (profile.status === "blocked") {

            await supabaseClient.auth.signOut();

            window.location.href = "login.html";

            return false;
        }

        currentProfile = profile;

        return true;
    }

    function displayProfile() {

        if (!currentProfile) {
            return;
        }

        const name =
            currentProfile.full_name || "Monarch";

        memberName.textContent = name;

        profileFullName.textContent =
            currentProfile.full_name || "—";

        profilePhone.textContent =
            currentProfile.phone || "—";

        profileStatus.textContent =
            currentProfile.status || "—";

        profileRole.textContent =
            currentProfile.role || "member";

        profileCreatedAt.textContent =
            formatDate(currentProfile.created_at);
    }

    function getPackageName(pkg) {

        if (!pkg) {
            return "Investment Package";
        }

        return (
            pkg.name ||
            pkg.title ||
            pkg.package_name ||
            "Investment Package"
        );
    }

    function getPackageAmount(pkg) {

        if (!pkg) {
            return 0;
        }

        return Number(
            pkg.amount ??
            pkg.price ??
            pkg.package_amount ??
            0
        );
    }
    async function loadPackages() {

        packagesContent.innerHTML =
            '<div class="loading-card">Loading packages...</div>';

        const {
            data,
            error
        } = await supabaseClient
            .from("packages")
            .select("*")
            .order("amount", {
                ascending: true
            });

        if (error) {
            console.error("Packages error:", error);

            packagesContent.innerHTML =
                '<div class="empty-card">Unable to load packages.</div>';

            return;
        }

        packagesData = data || [];

        renderPackages();
    }

    function renderPackages() {

        if (!packagesData.length) {

            packagesContent.innerHTML =
                '<div class="empty-card">No packages available.</div>';

            return;
        }

        packagesContent.innerHTML =
            packagesData.map(pkg => {

                const name =
                    getPackageName(pkg);

                const amount =
                    getPackageAmount(pkg);

                const selected =
                    selectedPackage &&
                    selectedPackage.id === pkg.id;

                return `
                    <button
                        type="button"
                        class="package-card ${selected ? "selected" : ""}"
                        data-package-id="${escapeHtml(pkg.id)}"
                    >
                        <span class="package-name">
                            ${escapeHtml(name)}
                        </span>

                        <span class="package-amount">
                            ${formatAmount(amount)}
                        </span>

                        <span class="package-action">
                            ${selected ? "Selected" : "Select Package"}
                        </span>
                    </button>
                `;

            }).join("");

        document
            .querySelectorAll(".package-card")
            .forEach(card => {

                card.addEventListener(
                    "click",
                    () => {

                        const packageId =
                            card.dataset.packageId;

                        selectPackage(packageId);
                    }
                );

            });
    }

    function selectPackage(packageId) {

        selectedPackage =
            packagesData.find(
                pkg =>
                    String(pkg.id) ===
                    String(packageId)
            ) || null;

        renderPackages();

        if (selectedPackage) {
            showMessage(
                `${getPackageName(selectedPackage)} selected.`,
                "success"
            );
        }
    }

    function selectPaymentMethod(method) {

        selectedPaymentMethod = method;

        document
            .querySelectorAll(".payment-option")
            .forEach(option => {

                option.classList.toggle(
                    "selected",
                    option.dataset.payment === method
                );

            });

        const methodName =
            method === "bank"
                ? "Bank Transfer"
                : "Cryptocurrency";

        showMessage(
            `${methodName} selected.`,
            "success"
        );
    }

    document
        .querySelectorAll(".payment-option")
        .forEach(option => {

            option.addEventListener(
                "click",
                () => {
                    selectPaymentMethod(
                        option.dataset.payment
                    );
                }
            );

        });

    async function loadInvestmentHistory() {

        historyContent.innerHTML =
            '<div class="loading-card">Loading investment history...</div>';

        const {
            data,
            error
        } = await supabaseClient
            .from("investments")
            .select("*")
            .eq("user_id", currentUser.id)
            .order("created_at", {
                ascending: false
            });

        if (error) {

            console.error(
                "Investment history error:",
                error
            );

            historyContent.innerHTML =
                '<div class="empty-card">Unable to load investment history.</div>';

            return;
        }

        investmentsData = data || [];

        updateFinancialStats();

        renderInvestmentHistory();
    }
        function updateFinancialStats() {
            const confirmed = investmentsData.filter(
                item => String(item.status || "").toLowerCase() === "confirmed"
            );

            const pending = investmentsData.filter(
                item => String(item.status || "").toLowerCase() === "pending"
            );

            const total = confirmed.reduce(
                (sum, item) => sum + (Number(item.amount) || 0),
                0
            );

            totalInvested.textContent = formatAmount(total);
            confirmedInvestments.textContent = confirmed.length;
            pendingInvestments.textContent = pending.length;
            totalRequests.textContent = investmentsData.length;

            const confirmedEarnings = earningsData.filter(
                item => String(item.status || "confirmed").toLowerCase() === "confirmed"
            );

            const earned = confirmedEarnings.reduce(
                (sum, item) => sum + (Number(item.amount) || 0),
                0
            );

            totalEarnings.textContent = formatAmount(earned);
        }

        function renderInvestmentHistory() {
            if (!investmentsData.length) {
                historyContent.innerHTML = `
                    <div class="empty-card">
                        No investment requests found.
                    </div>
                `;
                return;
            }

            historyContent.innerHTML = `
                <div class="table-wrapper">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Package</th>
                                <th>Amount</th>
                                <th>Payment</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${investmentsData.map(item => `
                                <tr>
                                    <td>${escapeHtml(getPackageName(item.package_id))}</td>
                                    <td>${formatAmount(item.amount)}</td>
                                    <td>${escapeHtml(
                                        String(item.payment_method || "").toUpperCase()
                                    )}</td>
                                    <td>${formatDate(item.created_at)}</td>
                                    <td>
                                        <span class="status ${getStatusClass(item.status)}">
                                            ${escapeHtml(item.status || "pending")}
                                        </span>
                                    </td>
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                </div>
            `;
        }

        async function loadEarnings() {
            earningsContent.innerHTML = `
                <div class="loading-card">
                    Loading earnings...
                </div>
            `;

            const { data, error } = await supabaseClient
                .from("earnings")
                .select("*")
                .eq("user_id", currentUser.id)
                .order("created_at", { ascending: false });

            if (error) {
                console.error("Earnings load error:", error);

                earningsData = [];

                earningsContent.innerHTML = `
                    <div class="empty-card">
                        Unable to load earnings right now.
                    </div>
                `;

                updateFinancialStats();
                return;
            }

            earningsData = data || [];

            updateFinancialStats();
            renderEarnings();
        }

        function renderEarnings() {
            if (!earningsData.length) {
                earningsContent.innerHTML = `
                    <div class="empty-card">
                        No earnings have been recorded yet.
                    </div>
                `;
                return;
            }

            earningsContent.innerHTML = `
                <div class="table-wrapper">
                    <table class="earnings-table">
                        <thead>
                            <tr>
                                <th>Amount</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${earningsData.map(item => `
                                <tr>
                                    <td class="earning-amount">
                                        ${formatAmount(item.amount)}
                                    </td>
                                    <td>
                                        ${escapeHtml(item.description || "Earning")}
                                    </td>
                                    <td>
                                        ${formatDate(item.created_at)}
                                    </td>
                                    <td>
                                        <span class="status ${getStatusClass(
                                            item.status || "confirmed"
                                        )}">
                                            ${escapeHtml(item.status || "confirmed")}
                                        </span>
                                    </td>
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                </div>
            `;
        }
        async function submitInvestmentRequest() {
            clearMessage();

            if (!selectedPackage) {
                showMessage("Please select an investment package.", "error");
                return;
            }

            if (!selectedPaymentMethod) {
                showMessage("Please select a payment method.", "error");
                return;
            }

            if (!currentUser) {
                showMessage("Your session has expired. Please log in again.", "error");
                return;
            }

            submitInvestmentBtn.disabled = true;
            submitInvestmentBtn.textContent = "Submitting...";

            const investmentAmount = getPackageAmount(selectedPackage);

            const { data, error } = await supabaseClient
                .from("investments")
                .insert([{
                    user_id: currentUser.id,
                    package_id: selectedPackage.id,
                    amount: investmentAmount,
                    payment_method: selectedPaymentMethod,
                    status: "pending"
                }])
                .select()
                .single();

            if (error) {
                console.error("Investment submission error:", error);

                showMessage(
                    error.message || "Unable to submit investment request.",
                    "error"
                );

                submitInvestmentBtn.disabled = false;
                submitInvestmentBtn.textContent = "Submit Investment Request";
                return;
            }

            investmentsData.unshift(data);

            updateFinancialStats();
            renderInvestmentHistory();

            selectedPackage = null;
            selectedPaymentMethod = null;

            document.querySelectorAll(".package-card").forEach(card => {
                card.classList.remove("selected");
            });

            document.querySelectorAll(".payment-option").forEach(option => {
                option.classList.remove("selected");
            });

            showMessage(
                "Investment request submitted successfully. It is now pending review.",
                "success"
            );

            submitInvestmentBtn.disabled = false;
            submitInvestmentBtn.textContent = "Submit Investment Request";
        }

        submitInvestmentBtn.addEventListener(
            "click",
            submitInvestmentRequest
        );

        async function logout() {
            const { error } = await supabaseClient.auth.signOut();

            if (error) {
                console.error("Logout error:", error);
                showMessage("Unable to log out. Please try again.", "error");
                return;
            }

            window.location.href = "login.html";
        }

        logoutBtn.addEventListener("click", logout);

        async function initializeDashboard() {
            clearMessage();

            try {
                const authorized = await checkMemberAuthorization();

                if (!authorized) {
                    return;
                }

                await loadPackages();
                await loadInvestmentHistory();
                await loadEarnings();

                displayProfile();

                updateFinancialStats();
            } catch (error) {
                console.error("Dashboard initialization error:", error);

                showMessage(
                    "Unable to load your dashboard. Please refresh the page.",
                    "error"
                );
            }
        }

        initializeDashboard();
    </script>

